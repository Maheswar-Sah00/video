{
  "name": "no-water",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Reel out/no-water.mp4 --concurrency=8 --crf=18 --image-format=jpeg --jpeg-quality=92",
    "mix": "remotion render src/index.ts Reel out/no-water-mix.wav --codec=wav",
    "finalize": "python scripts/finalize.py --mix out/mix_preview.wav",
    "typecheck": "tsc --noEmit",
    "deliver": "python scripts/ig_encode.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
